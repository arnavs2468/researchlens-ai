# ==============================================================================
# ResearchLens AI - Environment Configuration Example
# ==============================================================================

# Groq API Configuration (Free Tier available at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative Groq models:
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_MODEL=mixtral-8x7b-32768
# GROQ_MODEL=gemma2-9b-it

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Storage Paths (relative to project root or absolute)
DATA_DIR=data
PAPERS_STORAGE_DIR=data/papers
VECTOR_DB_DIR=data/chroma_db
METADATA_DB_PATH=data/papers_metadata.json
EVALUATION_DIR=data/evaluation

# Embedding Configuration (Local sentence-transformers, no paid API needed)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Chunking Configuration
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=150

# Retrieval Defaults
DEFAULT_RETRIEVAL_MODE=hybrid
DEFAULT_TOP_K=5
ENABLE_CROSS_ENCODER=false
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
